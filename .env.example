# Copy this file to .env in the repo root (or any parent folder) and fill in your own values.
# Never commit the real .env.

# Required: Portkey API key used to reach the OpenAI model.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: model name sent through Portkey (defaults to gpt-5.6-luna).
OPENAI_MODEL=gpt-5.6-luna

# Optional: secret for signing login sessions. Leave commented out to have one generated automatically
# into backend/.session_secret (gitignored). If you set it, use your own long random value, never this example.
# SESSION_SECRET=
